# ── Build situs ──────────────────────────────────────────────────────────────
# Nilai PUBLIC_* ditanam ke halaman saat build dan terlihat oleh pengunjung.
# Untuk Docker, kirim sebagai --build-arg; untuk Netlify, isi di pengaturan environment.

# API layanan pelanggan (cek tagihan, pengaduan)
PUBLIC_API_URL=https://open.tirtapatriot.net/web
# API Informasi Pelanggan (pengumuman gangguan dan pendaftaran sambungan baru, sama dengan aplikasi Tirta Patriot Mobile)
PUBLIC_INFO_PELANGGAN_API=https://pelanggan.api.tirtapatriot.co
# untuk uji coba pendaftaran tanpa menyentuh data produksi: https://pelanggan.api.staging.tirtapatriot.co
# Google reCAPTCHA v3, site key (publik). Wajib diisi saat build; tanpa ini cek tagihan dan pengaduan ditolak API.
# Domain situs harus terdaftar pada key ini di Google Cloud console.
PUBLIC_RECAPTCHA_SITE_KEY=6LdKx-4pAAAAAOxsfOX93guRi0sSreyEkOcsT_vX
# Peta interaktif: gaya peta dasar (MapLibre) dan server vector tile jaringan pipa (pg_tileserv)
PUBLIC_BASEMAP_STYLE=https://tiles.openfreemap.org/styles/positron
PUBLIC_PIPA_TILES=https://tile.api.tirtapatriot.com
# Widget obrolan Chatwoot (kosongkan untuk menonaktifkan)
PUBLIC_CHATWOOT_WEBSITE_TOKEN=LPKadeqQCpwESm9LQgr4kHVQ
PUBLIC_CHATWOOT_BASE_URL=https://omni.app.tirtapatriot.com

# ── Pembaruan data dari ERP (`bun run data`) ─────────────────────────────────
# Rahasia: hanya untuk dijalankan dari jaringan internal, jangan diberi awalan PUBLIC_
# dan jangan dimasukkan ke build situs. Gunakan akun baca-saja.
MSSQL_SERVER=
MSSQL_PORT=1433
MSSQL_USER=
MSSQL_PASSWORD=
# wajib: erp (produksi) atau zrp (staging); tidak ada nilai bawaan
MSSQL_DATABASE=
MSSQL_ENCRYPT=false
