---
import type { CollectionEntry } from 'astro:content'
import { getCollection, render } from 'astro:content'
import type { GetStaticPaths } from 'astro'
import { getImage, Image } from 'astro:assets'
import kantorPusat from '../../assets/kantor-pusat.webp'
import ArticleCard from '../../components/ArticleCard.astro'
import Icon from '../../components/Icon.astro'
import Base from '../../layouts/Base.astro'
import { coverTransition, getArtikel, JENIS, jenisOf } from '../../lib/artikel'
import { dateLong } from '../../lib/format'
import { plainText } from '../../lib/render-content'

export const getStaticPaths = (async () => {
  const articles = await getCollection('artikel', entry => !entry.data.draf)
  return articles.map(article => {
    const [jenis, ...rest] = article.id.split('/')
    return { params: { jenis, slug: rest.join('/') }, props: { article } }
  })
}) satisfies GetStaticPaths

type Props = { article: CollectionEntry<'artikel'> }

const { article } = Astro.props
const { Content } = await render(article)
const { judul, ringkasan, sampul, terbit, diperbarui } = article.data
const jenis = jenisOf(article)
const meta = JENIS[jenis]
const description = ringkasan ? plainText(ringkasan) : plainText(article.rendered?.html) || meta.lead
const cover = sampul ?? kantorPusat
const ogImage = await getImage({ src: cover, width: 1200, height: 630, fit: 'cover', format: 'jpg' })

const related = (await getArtikel(jenis)).filter(entry => entry.id !== article.id).slice(0, 3)

const shareUrl = new URL(`/${article.id}`, Astro.site).toString()
const shareText = encodeURIComponent(`${judul} ${shareUrl}`)
const shareTargets = [
  { label: 'WhatsApp', icon: 'mdi:whatsapp', href: `https://wa.me/?text=${shareText}` },
  { label: 'Facebook', icon: 'mdi:facebook', href: `https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(shareUrl)}` },
  { label: 'X', icon: 'mdi:twitter', href: `https://twitter.com/intent/tweet?text=${shareText}` },
]
---

<Base
  title={judul}
  description={description}
  image={new URL(ogImage.src, Astro.site).toString()}
  imageAlt={judul}
  type="article"
  publishedTime={terbit}
  modifiedTime={diperbarui}
  section={meta.title}
>
  <article>
    <header class="wrap wrap-narrow pt-8 md:pt-12">
      <nav aria-label="Lokasi halaman" class="text-sm text-redup">
        <a href={`/${jenis}`} class="inline-flex items-center gap-1 hover:text-patriot hover:underline">
          <Icon name="mdi:chevron-left" size={18} /> {meta.title}
        </a>
      </nav>
      <h1 class="mt-3 text-title font-extrabold">{judul}</h1>
      <p class="mt-3 text-redup">
        Diterbitkan <time datetime={terbit.toISOString()}>{dateLong(terbit)}</time>
      </p>
    </header>

    <div class="wrap mt-8 max-w-[60rem]">
      <div class="overflow-hidden rounded-2xl bg-air outline-1 -outline-offset-1 outline-pipa/10" style={`view-transition-name: ${coverTransition(article.id)}`}>
        <Image src={cover} alt="" widths={[480, 720, 960, 1440]} sizes="(min-width: 960px) 60rem, 100vw" width={1440} height={810} fit="cover" quality={72} class="aspect-video w-full object-cover" loading="eager" fetchpriority="high" />
      </div>
    </div>

    <div class="wrap wrap-narrow mt-10">
      <div class="content">
        <Content />
      </div>

      <div class="mt-12 flex flex-wrap items-center gap-2 border-t border-garis pt-6" data-share>
        <p class="mr-2 font-semibold">Bagikan</p>
        {shareTargets.map(target => (
          <a class="grid size-11 place-items-center rounded-md border border-garis hover:border-patriot hover:text-patriot" href={target.href} rel="noopener" target="_blank">
            <Icon name={target.icon} size={20} label={`Bagikan ke ${target.label}`} />
          </a>
        ))}
        <!-- Web Share API bawaan perangkat; bila tidak didukung, tautan disalin ke papan klip -->
        <button type="button" class="btn btn-quiet" data-share-native data-title={judul} data-text={description} data-path={`/${article.id}/`}>
          <Icon name="mdi:share-variant" size={20} />
          <span data-share-label>Bagikan artikel</span>
        </button>
      </div>
    </div>
  </article>

  {related.length > 0 && (
    <section class="wrap mt-16 border-t border-garis pt-10" aria-labelledby="terkait-judul">
      <h2 id="terkait-judul" class="text-xl font-bold">{jenis === 'berita' ? 'Berita lainnya' : 'Materi edukasi lainnya'}</h2>
      <div class="mt-6 grid gap-8 md:grid-cols-3">
        {related.map(entry => <ArticleCard article={entry} />)}
      </div>
    </section>
  )}
</Base>

<script>
  // tombol bagikan: lembar bagikan bawaan perangkat (Web Share API), tanpa pustaka pihak ketiga
  for (const button of document.querySelectorAll<HTMLButtonElement>('[data-share-native]')) {
    const label = button.querySelector('[data-share-label]')
    const idle = label?.textContent ?? ''
    const { title = document.title, text = '', path = location.pathname } = button.dataset
    // URL dari domain yang sedang dibuka, sehingga tautan yang dibagikan selalu bisa diakses
    const url = new URL(path, location.origin).toString()
    const data: ShareData = { title, text, url }
    const native = typeof navigator.share === 'function' && (navigator.canShare?.(data) ?? true)
    let timer = 0
    const flash = (message: string): void => {
      if (!label) {
        return
      }
      label.textContent = message
      clearTimeout(timer)
      timer = window.setTimeout(() => {
        label.textContent = idle
      }, 2500)
    }

    button.addEventListener('click', async () => {
      if (native) {
        try {
          await navigator.share(data)
          return
        } catch (error) {
          // AbortError = pengguna menutup lembar bagikan; galat lain jatuh ke salin tautan
          if ((error as DOMException).name === 'AbortError') {
            return
          }
        }
      }
      try {
        await navigator.clipboard.writeText(url)
        flash('Tautan disalin')
      } catch {
        flash('Salin manual dari bilah alamat')
      }
    })
  }
</script>
