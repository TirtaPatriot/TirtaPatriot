---
import HelpPanel from '../../components/HelpPanel.astro'
import Icon from '../../components/Icon.astro'
import PageHead from '../../components/PageHead.astro'
import Base from '../../layouts/Base.astro'
import { dateLong } from '../../lib/format'
import { hitungTagihan, rupiah, TARIF } from '../../lib/tarif'

// golongan paling banyak dipakai pelanggan (Rumah Tangga 3)
const BAWAAN = '2C'
const kelompok = [...new Set(TARIF.golongan.map(item => item.kelompok))]
const awal = hitungTagihan(TARIF.golongan.find(item => item.kode === BAWAAN)!, TARIF.meter[0]!.admin, 15)
const angka = (value: number) => new Intl.NumberFormat('id-ID').format(value)
---

<Base title="Tarif air dan simulasi tagihan" description="Tarif air minum per golongan pelanggan Perumda Tirta Patriot Kota Bekasi dan simulasi perkiraan tagihan dari pemakaian bulanan.">
  <PageHead
    title="Tarif air"
    lead="Hitung perkiraan tagihan dari pemakaian bulanan Anda, lalu lihat tarif lengkap setiap golongan pelanggan."
    crumbs={[{ title: 'Beranda', href: '/' }, { title: 'Layanan pelanggan', href: '/pelanggan' }]}
  />

  <div class="wrap mt-10">
    <section aria-labelledby="simulasi-judul" class="grid gap-10 lg:grid-cols-[minmax(0,1fr)_minmax(0,1.1fr)] lg:items-start">
      <form class="grid gap-6" data-simulasi onsubmit="return false">
        <h2 id="simulasi-judul" class="text-title font-extrabold">Simulasi tagihan</h2>

        <div class="field">
          <label for="sim-golongan">Golongan tarif</label>
          <select id="sim-golongan" name="golongan" class="input" aria-describedby="sim-golongan-hint">
            {kelompok.map(nama => (
              <optgroup label={nama}>
                {TARIF.golongan.filter(item => item.kelompok === nama).map(item => (
                  <option value={item.kode} selected={item.kode === BAWAAN}>{item.nama} ({item.kode})</option>
                ))}
              </optgroup>
            ))}
          </select>
          <p id="sim-golongan-hint" class="hint">Kode golongan tertera di rekening air Anda.</p>
        </div>

        <div class="field">
          <label for="sim-meter">Ukuran meter air</label>
          <select id="sim-meter" name="meter" class="input" aria-describedby="sim-meter-hint">
            {TARIF.meter.map((item, index) => <option value={index}>{item.ukuran} inci</option>)}
          </select>
          <p id="sim-meter-hint" class="hint">Sebagian besar rumah memakai meter 1/2 inci.</p>
        </div>

        <div class="field">
          <label for="sim-pakai">Pemakaian sebulan</label>
          <div class="flex items-center gap-4">
            <input id="sim-pakai-geser" type="range" min="0" max="60" value="15" class="h-2 flex-1 cursor-pointer accent-patriot" aria-hidden="true" tabindex="-1" data-geser>
            <div class="relative w-32">
              <input id="sim-pakai" name="pakai" type="number" inputmode="numeric" min="0" max="100000" value="15" class="input num pr-12 text-right text-lg font-bold" aria-describedby="sim-pakai-hint">
              <span class="pointer-events-none absolute top-1/2 right-4 -translate-y-1/2 text-redup">m³</span>
            </div>
          </div>
          <p id="sim-pakai-hint" class="hint">Selisih stan meter akhir dan awal. Rumah tangga rata-rata memakai sekitar 20 m³ sebulan.</p>
        </div>
      </form>

      <!-- hasil simulasi -->
      <div class="relative isolate overflow-hidden rounded-2xl bg-pipa p-6 text-white md:p-8" aria-live="polite" data-hasil>
        <div class="absolute inset-0 -z-10 bg-[radial-gradient(30rem_20rem_at_100%_0%,rgb(11_111_184/55%),transparent_70%)]" aria-hidden="true"></div>
        <p class="text-white/75">Perkiraan tagihan sebulan</p>
        <p class="num mt-1 text-[clamp(2.4rem,1.8rem+2.4vw,3.5rem)] leading-none font-extrabold tracking-tight" data-total>{rupiah(awal.total)}</p>
        <p class="mt-2 text-sm text-white/70" data-ditagih>Dihitung untuk {awal.ditagih} m³</p>

        <!-- batang blok: lebar sebanding biaya tiap blok -->
        <div class="mt-7 flex h-3 overflow-hidden rounded-full bg-white/10" aria-hidden="true" data-batang>
          {awal.blok.map((baris, index) => (
            <span class="h-full transition-[width] duration-500 ease-out" style={`width: ${awal.total ? (baris.biaya / awal.total) * 100 : 0}%; background: ${['#a9e6fa', '#3cc4f0', '#0b8fd8'][index]}`} />
          ))}
          <span class="h-full bg-white/50 transition-[width] duration-500 ease-out" style={`width: ${(awal.admin / awal.total) * 100}%`} />
        </div>

        <dl class="mt-6 grid gap-2.5 text-sm" data-rincian>
          {awal.blok.map((baris, index) => (
            <div class="flex items-center justify-between gap-4">
              <dt class="flex items-center gap-2 text-white/80">
                <span class="size-2.5 rounded-full" style={`background: ${['#a9e6fa', '#3cc4f0', '#0b8fd8'][index]}`} />
                <span data-label>{baris.sampai ? `${baris.dari}–${baris.sampai} m³` : `Di atas ${baris.dari - 1} m³`}</span>
                <span class="text-white/55" data-detail>{baris.m3} × {rupiah(baris.harga)}</span>
              </dt>
              <dd class="num font-semibold" data-nilai>{rupiah(baris.biaya)}</dd>
            </div>
          ))}
          <div class="flex items-center justify-between gap-4">
            <dt class="flex items-center gap-2 text-white/80"><span class="size-2.5 rounded-full bg-white/50" />Biaya administrasi</dt>
            <dd class="num font-semibold" data-admin>{rupiah(awal.admin)}</dd>
          </div>
          <div class="flex items-center justify-between gap-4" data-materai-baris hidden>
            <dt class="text-white/80">Bea materai</dt>
            <dd class="num font-semibold" data-materai>{rupiah(awal.materai)}</dd>
          </div>
        </dl>

        <p class="mt-6 border-t border-white/15 pt-4 text-sm text-white/70">
          Perkiraan, bukan tagihan resmi. Denda keterlambatan dan tunggakan tidak termasuk. Untuk tagihan sebenarnya, <a class="font-semibold text-aqua-soft underline underline-offset-2 hover:text-white" href="/pelanggan/tagihan">cek tagihan</a>.
        </p>
      </div>
    </section>

    <section class="mt-20" aria-labelledby="tabel-judul">
      <h2 id="tabel-judul" class="text-title font-extrabold">Tarif per golongan</h2>
      <p class="mt-2 max-w-[62ch] text-redup">
        Harga per m³ berlaku bertingkat: 10 m³ pertama dihitung dengan harga blok pertama, 10 m³ berikutnya dengan harga blok kedua, dan sisanya dengan harga blok ketiga. Setiap golongan ditagih paling sedikit 10 m³ sebulan.
      </p>

      <div class="mt-6 overflow-x-auto rounded-2xl border border-garis">
        <table class="w-full min-w-[40rem] border-collapse text-left">
          <thead class="bg-kabut text-sm">
            <tr>
              <th scope="col" class="px-5 py-3 font-semibold">Golongan</th>
              <th scope="col" class="px-5 py-3 text-right font-semibold">0–10 m³</th>
              <th scope="col" class="px-5 py-3 text-right font-semibold">11–20 m³</th>
              <th scope="col" class="px-5 py-3 text-right font-semibold">Di atas 20 m³</th>
              <th scope="col" class="px-5 py-3 text-right font-semibold">Denda</th>
            </tr>
          </thead>
          {kelompok.map(nama => (
            <tbody>
              <tr><th scope="rowgroup" colspan="5" class="border-t border-garis bg-white px-5 pt-5 pb-1 text-sm font-bold text-patriot">{nama}</th></tr>
              {TARIF.golongan.filter(item => item.kelompok === nama).map(item => (
                <tr class="border-t border-garis/60 transition-colors hover:bg-air/60">
                  <th scope="row" class="px-5 py-3 font-semibold"><span class="mr-2 text-redup">{item.kode}</span>{item.nama}</th>
                  {item.harga.map(harga => <td class="num px-5 py-3 text-right">{angka(harga)}</td>)}
                  <td class="num px-5 py-3 text-right text-redup">{item.dendaPersen ? `${String(item.dendaPersen).replace('.', ',')}%` : angka(item.denda ?? 0)}</td>
                </tr>
              ))}
            </tbody>
          ))}
        </table>
      </div>
      <p class="mt-3 text-sm text-redup">Harga dalam rupiah per m³. Denda dikenakan bila rekening dibayar setelah jatuh tempo; golongan dengan perjanjian dikenai persentase dari biaya air dan administrasi.</p>

      <div class="mt-12 grid gap-10 md:grid-cols-2">
        <section aria-labelledby="admin-judul">
          <h3 id="admin-judul" class="text-xl font-bold">Biaya administrasi per bulan</h3>
          <p class="mt-1 text-redup">Bergantung pada ukuran meter air yang terpasang.</p>
          <dl class="mt-4 grid grid-cols-2 gap-x-8 text-sm sm:grid-cols-3">
            {TARIF.meter.map(item => (
              <div class="flex justify-between border-b border-garis/70 py-2">
                <dt class="text-redup">{item.ukuran}"</dt>
                <dd class="num font-semibold">{angka(item.admin)}</dd>
              </div>
            ))}
          </dl>
        </section>
        <section aria-labelledby="ket-judul">
          <h3 id="ket-judul" class="text-xl font-bold">Keterangan</h3>
          <ul class="mt-4 grid gap-3 text-redup">
            <li class="flex gap-3"><Icon name="mdi:check-circle-outline" size={20} class="mt-0.5 shrink-0 text-patriot" />Tidak ada PPN pada rekening air.</li>
            <li class="flex gap-3"><Icon name="mdi:check-circle-outline" size={20} class="mt-0.5 shrink-0 text-patriot" />Bea materai Rp10.000 dikenakan bila tagihan mencapai Rp5.000.000.</li>
            <li class="flex gap-3"><Icon name="mdi:check-circle-outline" size={20} class="mt-0.5 shrink-0 text-patriot" />Golongan khusus untuk program atau perjanjian tertentu tidak dicantumkan; tanyakan ke unit pelayanan.</li>
          </ul>
          <p class="mt-5 text-sm text-redup">Data tarif dari sistem billing, diperbarui {dateLong(TARIF.diambil)}.</p>
        </section>
      </div>
    </section>

    <HelpPanel />
  </div>
</Base>

<script>
  import { hitungTagihan, rupiah, TARIF } from '../../lib/tarif'

  const form = document.querySelector<HTMLFormElement>('[data-simulasi]')!
  const golongan = form.querySelector<HTMLSelectElement>('[name="golongan"]')!
  const meter = form.querySelector<HTMLSelectElement>('[name="meter"]')!
  const pakai = form.querySelector<HTMLInputElement>('[name="pakai"]')!
  const geser = form.querySelector<HTMLInputElement>('[data-geser]')!
  const hasil = document.querySelector<HTMLElement>('[data-hasil]')!
  const total = hasil.querySelector<HTMLElement>('[data-total]')!
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches
  let shown = 0
  let frame = 0

  // angka total "mengalir" ke nilai baru seperti meter yang berputar
  function animateTotal (target: number): void {
    cancelAnimationFrame(frame)
    if (reduce) {
      shown = target
      total.textContent = rupiah(target)
      return
    }
    const from = shown
    const start = performance.now()
    const step = (now: number) => {
      const t = Math.min(1, (now - start) / 420)
      const eased = 1 - (1 - t) ** 3
      shown = Math.round(from + (target - from) * eased)
      total.textContent = rupiah(shown)
      if (t < 1) {
        frame = requestAnimationFrame(step)
      }
    }
    frame = requestAnimationFrame(step)
  }

  function update (): void {
    const gol = TARIF.golongan.find(item => item.kode === golongan.value) ?? TARIF.golongan[0]!
    const admin = TARIF.meter[Number(meter.value)]?.admin ?? 0
    const r = hitungTagihan(gol, admin, Number(pakai.value) || 0)

    animateTotal(r.total)
    hasil.querySelector('[data-ditagih]')!.textContent = r.ditagih > (Number(pakai.value) || 0)
      ? `Dihitung ${r.ditagih} m³ (pemakaian minimal golongan ${gol.kode})`
      : `Dihitung untuk ${r.ditagih} m³`

    const bars = [...hasil.querySelectorAll<HTMLElement>('[data-batang] > span')]
    r.blok.forEach((baris, index) => {
      bars[index]!.style.width = `${r.total ? (baris.biaya / r.total) * 100 : 0}%`
    })
    bars.at(-1)!.style.width = `${r.total ? ((r.admin + r.materai) / r.total) * 100 : 0}%`

    const rows = [...hasil.querySelectorAll<HTMLElement>('[data-rincian] > div')].slice(0, r.blok.length)
    r.blok.forEach((baris, index) => {
      const row = rows[index]!
      row.querySelector('[data-detail]')!.textContent = `${baris.m3} × ${rupiah(baris.harga)}`
      row.querySelector('[data-nilai]')!.textContent = rupiah(baris.biaya)
      row.classList.toggle('opacity-40', baris.m3 === 0)
    })
    hasil.querySelector('[data-admin]')!.textContent = rupiah(r.admin)
    hasil.querySelector<HTMLElement>('[data-materai-baris]')!.hidden = r.materai === 0
    hasil.querySelector('[data-materai]')!.textContent = rupiah(r.materai)
  }

  pakai.addEventListener('input', () => {
    geser.value = String(Math.min(Number(geser.max), Number(pakai.value) || 0))
    update()
  })
  geser.addEventListener('input', () => {
    pakai.value = geser.value
    update()
  })
  golongan.addEventListener('change', update)
  meter.addEventListener('change', update)

  shown = 0
  update()
</script>
