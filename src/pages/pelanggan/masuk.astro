---
import ErrorBox from '../../components/ErrorBox.astro'
import Icon from '../../components/Icon.astro'
import PageHead from '../../components/PageHead.astro'
import Base from '../../layouts/Base.astro'
import { INFO_PELANGGAN_API } from '../../lib/info-pelanggan'
---

<Base preconnect={[INFO_PELANGGAN_API]} title="Masuk akun pelanggan" description="Masuk dengan akun Tirta Patriot Mobile untuk catat meter mandiri dan pengajuan perubahan data pelanggan." noindex>
  <PageHead
    title="Akun pelanggan"
    lead="Gunakan akun yang sama dengan aplikasi Tirta Patriot Mobile."
    crumbs={[{ title: 'Beranda', href: '/' }, { title: 'Layanan pelanggan', href: '/pelanggan' }]}
  />

  <div class="wrap mt-10 grid gap-14 lg:grid-cols-[minmax(0,1fr)_minmax(0,1fr)]">
    <section class="max-w-md" aria-live="polite">
      <p class="notice notice-warn mb-6" data-expired hidden>Sesi Anda telah berakhir. Silakan masuk kembali.</p>

      <div data-views>
        <!-- masuk -->
        <form class="grid gap-5" novalidate data-view="masuk">
          <h2 class="text-2xl font-extrabold">Masuk</h2>
          <div class="field">
            <label for="m-hp">Nomor HP</label>
            <input id="m-hp" name="phone" class="input num" type="tel" inputmode="tel" autocomplete="tel" required placeholder="08xxxxxxxxxx">
          </div>
          <div class="field">
            <label for="m-pin">PIN</label>
            <input id="m-pin" name="pin" class="input num tracking-[0.4em]" type="password" inputmode="numeric" autocomplete="current-password" maxlength="6" pattern="\d{6}" required aria-describedby="m-pin-hint">
            <p id="m-pin-hint" class="hint">6 digit angka.</p>
          </div>
          <ErrorBox />
          <button type="submit" class="btn btn-primary justify-self-start px-6" data-idle="Masuk"><span data-label>Masuk</span></button>
          <p class="flex flex-wrap gap-x-5 gap-y-2 text-sm">
            <button type="button" class="link" data-go="lupa">Lupa PIN?</button>
            <span>Belum punya akun? <button type="button" class="link font-semibold" data-go="daftar">Daftar</button></span>
          </p>
        </form>

        <!-- daftar -->
        <form class="grid gap-5" novalidate data-view="daftar" hidden>
          <h2 class="text-2xl font-extrabold">Daftar akun</h2>
          <div class="field">
            <label for="d-nama">Nama lengkap</label>
            <input id="d-nama" name="name" class="input" autocomplete="name" maxlength="100" required>
          </div>
          <div class="field">
            <label for="d-hp">Nomor HP (WhatsApp)</label>
            <input id="d-hp" name="phone" class="input num" type="tel" inputmode="tel" autocomplete="tel" required aria-describedby="d-hp-hint">
            <p id="d-hp-hint" class="hint">Kode verifikasi dikirim lewat WhatsApp ke nomor ini.</p>
          </div>
          <div class="field">
            <label for="d-email">Email <span class="font-normal text-redup">(tidak wajib)</span></label>
            <input id="d-email" name="email" class="input" type="email" autocomplete="email" maxlength="100">
          </div>
          <div class="grid gap-5 sm:grid-cols-2">
            <div class="field">
              <label for="d-pin">Buat PIN</label>
              <input id="d-pin" name="pin" class="input num tracking-[0.4em]" type="password" inputmode="numeric" autocomplete="new-password" maxlength="6" required>
            </div>
            <div class="field">
              <label for="d-pin2">Ulangi PIN</label>
              <input id="d-pin2" name="pin2" class="input num tracking-[0.4em]" type="password" inputmode="numeric" autocomplete="new-password" maxlength="6" required>
            </div>
          </div>
          <fieldset class="grid gap-4 rounded-lg bg-kabut p-4">
            <legend class="sr-only">Nomor pelanggan</legend>
            <div class="field">
              <label for="d-nopel">Nomor pelanggan <span class="font-normal text-redup">(tidak wajib)</span></label>
              <input id="d-nopel" name="customer" class="input num" inputmode="numeric" maxlength="12" aria-describedby="d-nopel-hint">
              <p id="d-nopel-hint" class="hint">Dapat ditambahkan nanti. Bila diisi, sebutkan juga jumlah pembayaran rekening terakhir sebagai bukti kepemilikan.</p>
            </div>
            <div class="field" data-last-payment hidden>
              <label for="d-bayar">Jumlah pembayaran terakhir (Rp)</label>
              <input id="d-bayar" name="lastPayment" class="input num" inputmode="numeric" maxlength="12">
            </div>
          </fieldset>
          <ErrorBox />
          <div class="flex flex-wrap items-center gap-3">
            <button type="button" class="btn btn-quiet" data-go="masuk"><Icon name="mdi:chevron-left" size={20} /> Kembali</button>
            <button type="submit" class="btn btn-primary px-6" data-idle="Kirim kode verifikasi"><span data-label>Kirim kode verifikasi</span></button>
          </div>
        </form>

        <!-- lupa PIN -->
        <form class="grid gap-5" novalidate data-view="lupa" hidden>
          <h2 class="text-2xl font-extrabold">Atur ulang PIN</h2>
          <div class="field">
            <label for="l-hp">Nomor HP terdaftar</label>
            <input id="l-hp" name="phone" class="input num" type="tel" inputmode="tel" autocomplete="tel" required>
          </div>
          <div class="grid gap-5 sm:grid-cols-2">
            <div class="field">
              <label for="l-pin">PIN baru</label>
              <input id="l-pin" name="pin" class="input num tracking-[0.4em]" type="password" inputmode="numeric" autocomplete="new-password" maxlength="6" required>
            </div>
            <div class="field">
              <label for="l-pin2">Ulangi PIN baru</label>
              <input id="l-pin2" name="pin2" class="input num tracking-[0.4em]" type="password" inputmode="numeric" autocomplete="new-password" maxlength="6" required>
            </div>
          </div>
          <ErrorBox />
          <div class="flex flex-wrap items-center gap-3">
            <button type="button" class="btn btn-quiet" data-go="masuk"><Icon name="mdi:chevron-left" size={20} /> Kembali</button>
            <button type="submit" class="btn btn-primary px-6" data-idle="Kirim kode verifikasi"><span data-label>Kirim kode verifikasi</span></button>
          </div>
        </form>

        <!-- OTP -->
        <form class="grid gap-5" novalidate data-view="otp" hidden>
          <h2 class="text-2xl font-extrabold">Masukkan kode verifikasi</h2>
          <p>Kode 6 digit telah kami kirim lewat WhatsApp ke <strong data-otp-phone></strong>.</p>
          <div class="field">
            <label for="o-kode">Kode verifikasi</label>
            <input id="o-kode" name="otp" class="input num max-w-48 text-center text-2xl tracking-[0.5em]" inputmode="numeric" autocomplete="one-time-code" maxlength="6" required>
          </div>
          <ErrorBox />
          <div class="flex flex-wrap items-center gap-3">
            <button type="submit" class="btn btn-primary px-6" data-idle="Verifikasi"><span data-label>Verifikasi</span></button>
            <button type="button" class="btn btn-quiet" data-resend disabled>Kirim ulang kode</button>
          </div>
        </form>
      </div>
    </section>

    <aside class="self-start rounded-2xl bg-air p-6 sm:p-8">
      <h2 class="text-xl font-bold">Dengan akun pelanggan, Anda dapat</h2>
      <ul class="mt-4 grid gap-4">
        <li class="flex gap-3"><Icon name="mdi:camera-outline" size={24} class="shrink-0 text-patriot" /><span><strong class="block">Catat meter mandiri</strong>Laporkan angka meter air dengan foto langsung dari lokasi.</span></li>
        <li class="flex gap-3"><Icon name="mdi:account-edit-outline" size={24} class="shrink-0 text-patriot" /><span><strong class="block">Ajukan perubahan data</strong>Alamat, nama pelanggan, dan layanan lain tanpa datang ke kantor.</span></li>
        <li class="flex gap-3"><Icon name="mdi:cellphone" size={24} class="shrink-0 text-patriot" /><span><strong class="block">Satu akun untuk web dan aplikasi</strong>Akun yang sama berlaku di aplikasi Tirta Patriot Mobile.</span></li>
      </ul>
    </aside>
  </div>
</Base>

<script>
  import { initMasuk } from '../../scripts/masuk'

  initMasuk()
</script>
