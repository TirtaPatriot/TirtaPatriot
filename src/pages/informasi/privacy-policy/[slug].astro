---
import type { CollectionEntry } from 'astro:content'
import { getCollection, render } from 'astro:content'
import type { GetStaticPaths } from 'astro'
import PageHead from '../../../components/PageHead.astro'
import Base from '../../../layouts/Base.astro'

export const getStaticPaths = (async () => {
  const docs = await getCollection('legal')
  return docs.map(doc => ({ params: { slug: doc.id }, props: { doc } }))
}) satisfies GetStaticPaths

type Props = { doc: CollectionEntry<'legal'> }

const { doc } = Astro.props
const { Content } = await render(doc)
const { title, seoTitle, description, subtitle, badge, effective, partyLabel, party, links } = doc.data
---

<Base title={seoTitle.replace(/ - Perumda Tirta Patriot$/, '')} description={description}>
  <PageHead
    title={title}
    lead={subtitle}
    crumbs={[{ title: 'Beranda', href: '/' }, { title: 'Kebijakan privasi', href: '/informasi/privacy-policy' }]}
    narrow
  >
    <dl class="mt-6 grid gap-x-6 gap-y-1 text-sm sm:grid-cols-[auto_1fr]">
      {effective && (
        <>
          <dt class="font-semibold">Tanggal efektif</dt>
          <dd class="text-redup">{effective}</dd>
        </>
      )}
      <dt class="font-semibold">{partyLabel}</dt>
      <dd class="text-redup">{party}</dd>
      {badge && (
        <>
          <dt class="font-semibold">Berlaku untuk</dt>
          <dd class="text-redup">{badge}</dd>
        </>
      )}
      {links && links.length > 0 && (
        <>
          <dt class="font-semibold">Dokumen terkait</dt>
          <dd class="flex flex-wrap gap-x-4">
            {links.map(link => <a class="link" href={link.href}>{link.title}</a>)}
          </dd>
        </>
      )}
    </dl>
  </PageHead>

  <div class="wrap wrap-narrow mt-10">
    <div class="content">
      <Content />
    </div>
  </div>
</Base>
