---
import { getCollection, render } from 'astro:content'
import CmsImage from '../../components/CmsImage.astro'
import Icon from '../../components/Icon.astro'
import PageHead from '../../components/PageHead.astro'
import Base from '../../layouts/Base.astro'
import { dateTimeShort } from '../../lib/format'

const gangguan = await Promise.all((await getCollection('gangguan')).map(async entry => ({
  id: entry.id,
  ...entry.data,
  Content: (await render(entry)).Content,
})))
---

<Base title="Gangguan layanan" description="Informasi gangguan layanan air bersih Perumda Tirta Patriot Kota Bekasi yang sedang berlangsung beserta perkiraan pemulihannya.">
  <PageHead
    title="Gangguan layanan"
    lead="Gangguan yang sedang ditangani dan perkiraan waktu pemulihannya. Halaman ini memuat data terbaru setiap kali dibuka."
    crumbs={[{ title: 'Beranda', href: '/' }, { title: 'Informasi' }]}
    narrow
  />

  <div class="wrap wrap-narrow mt-10">
    <div class="notice notice-ok p-6" data-gangguan-empty hidden={gangguan.length > 0}>
      <Icon name="mdi:water-check-outline" size={28} />
      <div>
        <h2 class="text-xl font-bold">Tidak ada gangguan yang tercatat</h2>
        <p class="mt-1">Bila air di rumah Anda tidak mengalir atau keruh, laporkan agar petugas dapat memeriksanya.</p>
        <a class="btn btn-primary mt-4" href="/pelanggan/pengaduan">Lapor gangguan</a>
      </div>
    </div>

    <div class="grid gap-8" data-gangguan-list hidden={gangguan.length === 0}>
      {gangguan.map(item => (
        <article class="overflow-hidden rounded-lg border border-garis" data-gangguan-id={item.id}>
          {item.image && <CmsImage src={item.image} alt="" ratio={2} widths={[640, 960]} sizes="(min-width: 768px) 48rem, 100vw" class="w-full" />}
          <div class="p-5 sm:p-6">
            <p class="text-sm font-bold text-meter">Sedang ditangani</p>
            <h2 class="mt-1 text-xl font-bold">{item.title}</h2>
            {item.subtitle && <p class="mt-1 text-redup">{item.subtitle}</p>}
            <div class="content mt-4"><item.Content /></div>
            <dl class="mt-4 grid gap-1 text-sm sm:grid-cols-2">
              <dt class="font-semibold">Mulai</dt>
              <dd class="text-redup">{dateTimeShort(item.mulai) || 'Belum tercatat'}</dd>
              <dt class="font-semibold">Perkiraan selesai</dt>
              <dd class="text-redup">{item.estimasi ? dateTimeShort(item.estimasi) : 'Belum ditentukan'}</dd>
            </dl>
          </div>
        </article>
      ))}
    </div>
  </div>
</Base>

<script>
  import { refreshGangguanPage } from '../../scripts/gangguan'

  void refreshGangguanPage()
</script>
