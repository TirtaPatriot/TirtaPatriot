---
import { getCollection } from 'astro:content'
import OfficeList from '../../components/OfficeList.astro'
import PageHead from '../../components/PageHead.astro'
import Base from '../../layouts/Base.astro'
import { assetUrl } from '../../lib/directus'

const mitra = (await getCollection('mitra')).map(entry => entry.data)
---

<Base title="Tempat pembayaran" description="Mitra pembayaran dan unit pelayanan resmi untuk membayar rekening air Perumda Tirta Patriot Kota Bekasi.">
  <PageHead
    title="Tempat pembayaran"
    lead="Bayar rekening air di mitra resmi kami, atau datang langsung ke unit pelayanan terdekat."
    crumbs={[{ title: 'Beranda', href: '/' }, { title: 'Informasi' }]}
  />

  <div class="wrap mt-10">
    {mitra.length > 0 && (
      <section aria-labelledby="mitra-judul">
        <h2 id="mitra-judul" class="text-2xl font-extrabold">Mitra pembayaran</h2>
        <ul class="mt-6 grid grid-cols-2 gap-3 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-6">
          {mitra.map(partner => (
            <li>
              <a href={partner.url} rel="noopener" target="_blank" class="grid aspect-[3/2] place-items-center rounded-lg border border-garis bg-white p-4 hover:border-patriot">
                <img src={assetUrl(partner.logo, { width: 240, format: 'png' })} alt={partner.name} width="240" height="160" loading="lazy" decoding="async" class="max-h-full w-auto object-contain">
              </a>
            </li>
          ))}
        </ul>
      </section>
    )}

    <section class="mt-14 border-t border-garis pt-10" aria-labelledby="unit-judul">
      <h2 id="unit-judul" class="mb-2 text-2xl font-extrabold">Unit pelayanan</h2>
      <p class="mb-6 text-redup">Pembayaran langsung dilayani pada jam operasional.</p>
      <OfficeList searchable />
    </section>
  </div>
</Base>
