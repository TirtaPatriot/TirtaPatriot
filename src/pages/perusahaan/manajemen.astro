---
import { getCollection } from 'astro:content'
import { Image } from 'astro:assets'
import sotk from '../../assets/halaman/sotk.jpg'
import Icon from '../../components/Icon.astro'
import PageHead from '../../components/PageHead.astro'
import direksiJson from '../../data/direksi.json'
import Base from '../../layouts/Base.astro'
import { titleCase } from '../../lib/format'

// urutan mengikuti src/data/direksi.json (Direktur Utama lebih dulu); loader file() tidak menjamin urutan
const order = direksiJson.map(item => item.id)
const direksi = (await getCollection('direksi')).toSorted((a, b) => order.indexOf(a.id) - order.indexOf(b.id)).map(entry => entry.data)
---

<Base title="Manajemen" description="Jajaran direksi serta susunan organisasi dan tata kerja Perumda Tirta Patriot Kota Bekasi.">
  <PageHead
    title="Manajemen"
    lead="Pimpinan dan susunan organisasi Perumda Tirta Patriot Kota Bekasi."
    crumbs={[{ title: 'Beranda', href: '/' }, { title: 'Perusahaan' }]}
  />

  <div class="wrap mt-10">
    <section id="direksi" aria-labelledby="direksi-judul">
      <h2 id="direksi-judul" class="text-2xl font-extrabold">Jajaran direksi</h2>
      <ul class="mt-6 grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
        {direksi.map(person => (
          <li>
            {person.foto ? (
              <Image src={person.foto} alt={`Foto ${titleCase(person.nama)}`} widths={[320, 480, 640]} sizes="(min-width: 1024px) 30vw, (min-width: 640px) 45vw, 100vw" width={640} height={800} fit="cover" class="aspect-[4/5] w-full rounded-2xl bg-air object-cover" />
            ) : <div class="aspect-[4/5] w-full rounded-2xl bg-air" />}
            <h3 class="mt-3 text-lg font-bold">{person.nama}</h3>
            <p class="text-redup">{titleCase(person.jabatan)}</p>
          </li>
        ))}
      </ul>
    </section>

    <section id="sotk" class="mt-16 border-t border-garis pt-10" aria-labelledby="sotk-judul">
      <h2 id="sotk-judul" class="text-2xl font-extrabold">Susunan organisasi dan tata kerja</h2>
      <p class="mt-2 text-redup">Geser bagan ke samping untuk melihat seluruhnya, atau buka gambar ukuran penuh.</p>
      <div class="mt-6 overflow-x-auto rounded-lg border border-garis p-3">
        <Image src={sotk} alt="Bagan susunan organisasi dan tata kerja Perumda Tirta Patriot" widths={[1100, 1600, 2200]} sizes="(min-width: 1152px) 72rem, 44rem" class="h-auto max-w-none min-w-[44rem] lg:w-full lg:min-w-0" />
      </div>
      <a class="link mt-4 inline-flex items-center gap-1.5" href={sotk.src} rel="noopener" target="_blank">
        <Icon name="mdi:open-in-new" size={18} /> Buka gambar ukuran penuh
      </a>
    </section>
  </div>
</Base>
