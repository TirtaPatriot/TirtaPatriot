---
/**
 * Kepala halaman: jejak lokasi (bagian situs), judul, dan kalimat pengantar di atas latar pipa,
 * ditutup gelombang air yang menyambung ke isi halaman. Rata kiri, sejajar dengan isi.
 */
import { breadcrumbLd, ldJson } from '../lib/seo'
import Waves from './Waves.astro'

type Crumb = { title: string, href?: string }

type Props = {
  title: string
  lead?: string
  crumbs?: Crumb[]
  narrow?: boolean
}

const { title, lead, crumbs = [], narrow = false } = Astro.props

// jejak untuk mesin pencari: hanya bagian yang punya halaman, ditutup halaman ini sendiri
const trail = crumbs.length
  ? [...crumbs.filter(crumb => crumb.href).map(crumb => ({ name: crumb.title, url: new URL(crumb.href!, Astro.site).toString() })), { name: title, url: new URL(Astro.url.pathname, Astro.site).toString() }]
  : []
---

{trail.length > 1 && <script type="application/ld+json" set:html={ldJson(breadcrumbLd(trail))} />}

<div class="relative isolate overflow-hidden bg-pipa text-white">
  <div class="absolute inset-0 -z-10 bg-[radial-gradient(48rem_28rem_at_90%_-20%,rgb(0_152_218/50%),transparent_70%)]" aria-hidden="true"></div>
  <div class:list={['wrap pt-10 pb-20 md:pt-14 md:pb-28', narrow && 'wrap-narrow']}>
    {crumbs.length > 0 && (
      <nav aria-label="Lokasi halaman" class="enter mb-4 text-sm text-white/70" style="--i: 0">
        <ol class="flex flex-wrap items-center gap-x-2">
          {crumbs.map((crumb, index) => (
            <li class="flex items-center gap-2">
              {index > 0 && <span aria-hidden="true" class="text-white/40">/</span>}
              {crumb.href ? <a href={crumb.href} class="hover:text-white hover:underline">{crumb.title}</a> : <span>{crumb.title}</span>}
            </li>
          ))}
        </ol>
      </nav>
    )}
    <h1 class="text-display font-extrabold">
      <span class="line-mask"><span style="--i: 1">{title}</span></span>
    </h1>
    {lead && <p class="enter mt-4 max-w-[60ch] text-lg text-white/80" style="--i: 3">{lead}</p>}
    <slot />
  </div>
  <Waves />
</div>
