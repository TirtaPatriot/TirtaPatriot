---
import { Image } from 'astro:assets'
import { getCollection } from 'astro:content'
import wordmark from '../assets/logo-wordmark.png'
import navigasiJson from '../data/navigasi.json'
import Icon from './Icon.astro'

// urutan mengikuti urutan di src/data/navigasi.json (loader file() tidak menjamin urutan)
const order = navigasiJson.map(item => item.id)
const navigation = (await getCollection('navigasi')).toSorted((a, b) => order.indexOf(a.id) - order.indexOf(b.id)).map(({ data }) => ({
  title: data.judul,
  href: data.tautan ?? '',
  external: /^https?:/.test(data.tautan ?? ''),
  children: data.anak.map(child => ({ title: child.judul, href: child.tautan, external: /^https?:/.test(child.tautan) })),
}))
// tautan ke situs lain (Lelang) di pojok kanan, setelah tombol Layanan Pelanggan
const main = navigation.filter(item => item.children.length || !item.external)
const corner = navigation.filter(item => !item.children.length && item.external)
const path = Astro.url.pathname.replace(/\/+$/, '') || '/'

function isCurrent (href: string): boolean {
  if (!href || /^https?:/.test(href)) {
    return false
  }
  return href === '/' ? path === '/' : path === href || path.startsWith(`${href}/`)
}

const searchInput = 'h-10 w-full rounded-full border border-garis bg-white pr-3 pl-9 text-sm text-pipa placeholder:text-redup hover:border-pipa-soft focus:border-patriot focus:outline-2 focus:outline-patriot [&::-webkit-search-cancel-button]:cursor-pointer'
const linkClass = 'inline-flex min-h-11 items-center gap-1.5 rounded-md px-3 font-semibold text-pipa hover:bg-air aria-[current=page]:text-patriot'
---

<header class="site-header sticky top-0 z-40 border-b border-transparent bg-white/85 backdrop-blur-md backdrop-saturate-150 transition-[border-color,box-shadow] duration-300 data-[scrolled]:border-garis data-[scrolled]:shadow-[0_8px_24px_-16px_rgb(10_42_94/35%)]" style="view-transition-name: site-header" data-site-header>
  <!-- selebar layar: logo dan kolom cari di kiri, menu di kanan, tautan situs lain (Lelang) di pojok kanan -->
  <div class="flex h-16 w-full items-center justify-between gap-4 px-4 sm:px-6 xl:px-8">
    <a href="/" class="shrink-0" aria-label="Beranda Perumda Tirta Patriot">
      <Image src={wordmark} alt="" width={125} height={40} densities={[1, 2]} class="h-10 w-auto" loading="eager" />
    </a>

    <form action="/cari" method="get" role="search" class="relative mr-auto hidden lg:block" data-cari-form>
      <label for="cari-header" class="sr-only">Cari di situs</label>
      <Icon name="mdi:magnify" size={20} class="pointer-events-none absolute top-1/2 left-2.5 -translate-y-1/2 text-redup" />
      <input id="cari-header" class:list={[searchInput, 'w-44 transition-[width] duration-300 xl:w-64 xl:focus:w-80']} type="search" name="q" autocomplete="off" enterkeyhint="search" placeholder="Cari…">
      <ul class="absolute top-full left-0 mt-2 grid w-[24rem] gap-0.5 rounded-xl border border-garis bg-white p-1.5 shadow-lift" hidden data-cari-saran></ul>
    </form>

    <nav aria-label="Menu utama" class="hidden lg:block">
      <ul class="flex items-center gap-1">
        {main.map(item => (
          <li class="relative">
            {item.children.length ? (
              <details class="nav-menu group">
                <summary class:list={[linkClass, 'cursor-pointer list-none [&::-webkit-details-marker]:hidden', item.children.some(child => isCurrent(child.href)) && 'text-patriot']}>
                  {item.title}
                  <Icon name="mdi:chevron-down" size={18} class="transition-transform group-open:rotate-180" />
                </summary>
                <ul class="nav-dropdown absolute top-full left-0 mt-2 grid min-w-60 gap-0.5 origin-top-left rounded-xl border border-garis bg-white p-1.5 shadow-lift">
                  {item.children.map(child => (
                    <li>
                      <a href={child.href} class="block rounded-lg px-3 py-2.5 transition-colors hover:bg-kabut aria-[current=page]:bg-air aria-[current=page]:font-semibold aria-[current=page]:text-patriot aria-[current=page]:shadow-[inset_3px_0_0_var(--color-patriot)] aria-[current=page]:hover:bg-air-strong" aria-current={isCurrent(child.href) ? 'page' : undefined} {...(child.external ? { rel: 'noopener', target: '_blank' } : {})}>
                        {child.title}
                      </a>
                    </li>
                  ))}
                </ul>
              </details>
            ) : (
              <a href={item.href} class={linkClass} aria-current={isCurrent(item.href) ? 'page' : undefined} {...(item.external ? { rel: 'noopener', target: '_blank' } : {})}>
                {item.title}
                {item.external && <Icon name="mdi:open-in-new" size={15} label="(situs lain)" />}
              </a>
            )}
          </li>
        ))}
        <li class="ml-2">
          <a href="/pelanggan" class="btn btn-primary whitespace-nowrap" aria-current={isCurrent('/pelanggan') ? 'page' : undefined}>Layanan Pelanggan</a>
        </li>
        {corner.map(item => (
          <li class="ml-2 xl:ml-6">
            <a href={item.href} class={linkClass} rel="noopener" target="_blank">
              {item.title}
              <Icon name="mdi:open-in-new" size={15} label="(situs lain)" />
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <button type="button" class="btn btn-quiet lg:hidden" aria-expanded="false" aria-controls="menu-ponsel" data-menu-toggle>
      <Icon name="mdi:menu" size={22} />
      Menu
    </button>
  </div>

  <nav id="menu-ponsel" aria-label="Menu utama" class="mobile-menu border-t border-garis bg-white lg:hidden" hidden>
    <ul class="wrap flex flex-col py-3">
      <li class="pb-3">
        <form action="/cari" method="get" role="search" class="relative" data-cari-form>
          <label for="cari-ponsel" class="sr-only">Cari di situs</label>
          <Icon name="mdi:magnify" size={20} class="pointer-events-none absolute top-5 left-2.5 -translate-y-1/2 text-redup" />
          <input id="cari-ponsel" class:list={[searchInput, 'h-10 text-base']} type="search" name="q" autocomplete="off" enterkeyhint="search" placeholder="Cari berita, menu…">
          <ul class="mt-2 grid gap-0.5 rounded-xl border border-garis p-1.5" hidden data-cari-saran></ul>
        </form>
      </li>
      <li class="pb-2">
        <a href="/pelanggan" class="btn btn-primary w-full">Layanan Pelanggan</a>
      </li>
      {[...main, ...corner].map(item => (
        <li>
          {item.children.length ? (
            <>
              <p class="px-3 pt-4 pb-1 text-sm font-semibold text-redup">{item.title}</p>
              <ul>
                {item.children.map(child => (
                  <li><a href={child.href} class={linkClass} aria-current={isCurrent(child.href) ? 'page' : undefined}>{child.title}</a></li>
                ))}
              </ul>
            </>
          ) : (
            <a href={item.href} class={linkClass} aria-current={isCurrent(item.href) ? 'page' : undefined} {...(item.external ? { rel: 'noopener', target: '_blank' } : {})}>
              {item.title}
              {item.external && <Icon name="mdi:open-in-new" size={15} label="(situs lain)" />}
            </a>
          )}
        </li>
      ))}
    </ul>
  </nav>
</header>

<script>
  import '../scripts/cari'

  // bayangan tipis setelah halaman digulir
  const header = document.querySelector<HTMLElement>('[data-site-header]')
  const onScroll = () => header?.toggleAttribute('data-scrolled', window.scrollY > 8)
  window.addEventListener('scroll', onScroll, { passive: true })
  onScroll()

  const toggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]')
  const panel = document.querySelector<HTMLElement>('#menu-ponsel')

  toggle?.addEventListener('click', () => {
    const open = toggle.getAttribute('aria-expanded') !== 'true'
    toggle.setAttribute('aria-expanded', String(open))
    if (panel) {
      panel.hidden = !open
    }
  })

  // hanya satu submenu terbuka; klik di luar atau Escape menutupnya
  const menus = [...document.querySelectorAll<HTMLDetailsElement>('details.nav-menu')]
  for (const menu of menus) {
    menu.addEventListener('toggle', () => {
      if (menu.open) {
        for (const other of menus) {
          if (other !== menu) {
            other.open = false
          }
        }
      }
    })
  }

  document.addEventListener('click', event => {
    for (const menu of menus) {
      if (menu.open && !menu.contains(event.target as Node)) {
        menu.open = false
      }
    }
  })

  document.addEventListener('keydown', event => {
    if (event.key !== 'Escape') {
      return
    }
    for (const menu of menus) {
      if (menu.open) {
        menu.open = false
        menu.querySelector('summary')?.focus()
      }
    }
  })
</script>
