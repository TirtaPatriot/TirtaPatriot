---
/**
 * Pencarian global sebagai modal: dibuka tombol cari di header, Ctrl/⌘+K, atau "/".
 * Hasil (menu, berita, edukasi) dipilih dengan panah atas/bawah lalu Enter; lihat src/scripts/cari.ts.
 * Tanpa JavaScript, formulirnya tetap membuka /cari.
 */
import Icon from './Icon.astro'

const contoh = ['cek tagihan', 'pasang baru', 'gangguan layanan', 'tempat pembayaran', 'tarif air', 'lapor kebocoran']
const kbd = 'rounded-md border border-garis bg-kabut px-1.5 py-0.5 font-sans font-semibold text-pipa'
---

<dialog class="mx-auto mt-[12vh] mb-auto w-[min(calc(100vw-2rem),40rem)] overflow-hidden rounded-2xl border border-garis bg-white p-0 text-pipa shadow-lift backdrop:bg-pipa/45 backdrop:backdrop-blur-sm" aria-label="Cari di situs" data-cari-dialog>
  <form action="/cari" method="get" role="search" class="flex items-center gap-3 border-b border-garis py-3 pr-3 pl-4">
    <Icon name="mdi:magnify" size={24} class="shrink-0 text-redup" />
    <label for="cari-dialog" class="sr-only">Kata kunci</label>
    <input
      id="cari-dialog"
      class="min-w-0 flex-1 bg-transparent text-lg outline-none placeholder:text-redup [&::-webkit-search-cancel-button]:hidden"
      type="search"
      name="q"
      role="combobox"
      aria-expanded="false"
      aria-controls="cari-dialog-hasil"
      aria-autocomplete="list"
      autocomplete="off"
      enterkeyhint="search"
      placeholder="Cari layanan, menu, atau berita…"
    >
    <button type="submit" class="btn btn-primary min-h-10 shrink-0 px-4">Cari</button>
  </form>

  <div class="max-h-[min(60vh,32rem)] overflow-y-auto p-4">
    <div data-cari-contoh>
      <p class="text-xs font-bold tracking-wide text-redup uppercase">Coba cari</p>
      <div class="mt-3 flex flex-wrap gap-2">
        {contoh.map(text => (
          <button type="button" class="cursor-pointer rounded-full border border-garis px-3.5 py-1.5 text-sm font-semibold transition-colors hover:border-patriot hover:bg-air hover:text-patriot" data-cari-isi={text}>{text}</button>
        ))}
      </div>
    </div>
    <ul id="cari-dialog-hasil" role="listbox" aria-label="Hasil pencarian" class="grid gap-0.5" hidden data-cari-hasil-dialog></ul>
    <p class="px-1 py-2 text-redup" role="status" data-cari-dialog-status></p>
  </div>

  <p class="hidden flex-wrap items-center gap-x-1.5 gap-y-1 border-t border-garis bg-kabut px-4 py-3 text-xs text-redup sm:flex">
    <kbd class={kbd}>/</kbd> atau <kbd class={kbd} data-cari-pintasan>Ctrl</kbd>+<kbd class={kbd}>K</kbd> buka ·
    <kbd class={kbd}>↑</kbd><kbd class={kbd}>↓</kbd> pilih ·
    <kbd class={kbd}>Enter</kbd> buka ·
    <kbd class={kbd}>Esc</kbd> tutup
  </p>
</dialog>
