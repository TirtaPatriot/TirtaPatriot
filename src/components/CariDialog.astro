---
/**
 * Pencarian global sebagai modal: dibuka tombol cari di header (di ponsel tombol melayang) atau tombol "/".
 * Kolom kosong menampilkan kartu pintasan; saat mengetik diganti hasil (menu, berita, edukasi) yang dipilih
 * dengan panah atas/bawah lalu Enter; lihat src/scripts/cari.ts. Tanpa JavaScript, formulirnya tetap membuka /cari.
 */
import Icon from './Icon.astro'

const pintasan = [
  { judul: 'Cek tagihan', href: '/pelanggan/tagihan', icon: 'mdi:receipt-text-outline' },
  { judul: 'Pasang baru', href: '/pelanggan/pendaftaran', icon: 'mdi:water-plus-outline' },
  { judul: 'Gangguan layanan', href: '/informasi/gangguan-layanan', icon: 'mdi:alert-circle-outline' },
  { judul: 'Tempat pembayaran', href: '/informasi/tempat-pembayaran', icon: 'mdi:map-marker-outline' },
  { judul: 'Tarif air', href: '/pelanggan/tarif', icon: 'mdi:calculator-variant-outline' },
  { judul: 'Lapor kebocoran', href: '/pelanggan/lapor-kebocoran', icon: 'mdi:pipe-leak' },
]
const kbd = 'rounded-md border border-garis bg-white px-1.5 py-0.5 font-sans font-semibold text-pipa'
---

<dialog class="mx-auto mt-[12vh] mb-auto w-[min(calc(100vw-2rem),40rem)] overflow-hidden rounded-2xl border border-garis bg-white p-0 text-pipa shadow-lift backdrop:bg-pipa/45 backdrop:backdrop-blur-sm" aria-label="Cari di situs" data-cari-dialog>
  <form action="/cari" method="get" role="search" class="flex items-center gap-3 bg-pipa py-3 pr-3 pl-4 text-white">
    <Icon name="mdi:magnify" size={24} class="shrink-0 text-emas" />
    <label for="cari-dialog" class="sr-only">Kata kunci</label>
    <input
      id="cari-dialog"
      class="min-w-0 flex-1 bg-transparent text-lg caret-emas outline-none placeholder:text-white/70 [&::-webkit-search-cancel-button]:hidden"
      type="search"
      name="q"
      role="combobox"
      aria-expanded="false"
      aria-controls="cari-dialog-hasil"
      aria-autocomplete="list"
      autocomplete="off"
      enterkeyhint="search"
      placeholder="Cari layanan, menu, atau berita…"
    >
    <button type="submit" class="sr-only">Cari</button>
    <button type="button" class="inline-flex min-h-10 min-w-10 shrink-0 cursor-pointer items-center justify-center rounded-lg bg-white/15 text-xs font-bold text-white transition-colors hover:bg-white/25 sm:px-2.5" aria-label="Tutup pencarian" data-cari-tutup>
      <Icon name="mdi:close" size={20} class="sm:hidden" />
      <span class="hidden sm:inline">Esc</span>
    </button>
  </form>

  <div class="max-h-[min(60vh,32rem)] overflow-y-auto p-4">
    <div data-cari-contoh>
      <p class="text-xs font-bold tracking-wide text-redup uppercase">Pintasan</p>
      <ul class="mt-3 grid gap-2 sm:grid-cols-2">
        {pintasan.map(item => (
          <li>
            <a href={item.href} class="group flex min-h-14 items-center gap-3 rounded-xl border border-garis px-3 py-2 font-semibold transition-colors hover:border-patriot hover:bg-air">
              <span class="grid size-9 shrink-0 place-items-center rounded-full bg-air text-patriot transition-colors group-hover:bg-white"><Icon name={item.icon} size={20} /></span>
              {item.judul}
            </a>
          </li>
        ))}
      </ul>
    </div>
    <ul id="cari-dialog-hasil" role="listbox" aria-label="Hasil pencarian" class="grid gap-0.5" hidden data-cari-hasil-dialog></ul>
    <p class="px-1 py-2 text-redup" role="status" data-cari-dialog-status></p>
  </div>

  <p class="hidden flex-wrap items-center gap-x-1.5 gap-y-1 border-t border-garis bg-kabut px-4 py-3 text-xs text-redup sm:flex">
    <kbd class={kbd}>/</kbd> buka pencarian ·
    <kbd class={kbd}>↑</kbd><kbd class={kbd}>↓</kbd> pilih ·
    <kbd class={kbd}>Enter</kbd> buka ·
    <kbd class={kbd}>Esc</kbd> tutup
  </p>
</dialog>
