---
import { ADDRESS, HOURS, SITE_LEGAL_NAME, SOCIALS } from '../lib/site'
import Icon from './Icon.astro'
import Waves from './Waves.astro'

const services = [
  { title: 'Cek tagihan', href: '/pelanggan/tagihan' },
  { title: 'Pengaduan', href: '/pelanggan/pengaduan' },
  { title: 'Tarif & simulasi tagihan', href: '/pelanggan/tarif' },
  { title: 'Pasang baru', href: '/pelanggan/pendaftaran' },
  { title: 'Tempat pembayaran', href: '/informasi/tempat-pembayaran' },
  { title: 'Gangguan layanan', href: '/informasi/gangguan-layanan' },
]

const info = [
  { title: 'Berita', href: '/berita' },
  { title: 'Edukasi', href: '/edukasi' },
  { title: 'Sejarah', href: '/perusahaan/sejarah' },
  { title: 'Manajemen', href: '/perusahaan/manajemen' },
  { title: 'Kontak', href: '/perusahaan/kontak' },
  { title: 'Kebijakan privasi & ketentuan', href: '/informasi/privacy-policy' },
]

const year = new Date().getFullYear()
---

<footer class="relative isolate mt-24 overflow-hidden bg-pipa text-white">
  <Waves flip />
  <div class="wrap grid gap-10 pt-24 pb-12 md:grid-cols-[1.4fr_1fr_1fr] md:pt-28">
    <div class="max-w-sm">
      <h2 class="text-lg font-bold">Kantor pusat</h2>
      <p class="mt-2 text-white/85">{ADDRESS}</p>
      <p class="mt-3 text-white/85">Buka {HOURS}</p>
      <p class="mt-3 flex flex-col gap-1">
        <a class="inline-flex items-center gap-2 hover:underline" href="tel:+622188966161"><Icon name="mdi:phone-outline" size={18} /> 021-8896-6161</a>
        <a class="inline-flex items-center gap-2 hover:underline" href="mailto:humas@tirtapatriot.co.id"><Icon name="mdi:email-outline" size={18} /> humas@tirtapatriot.co.id</a>
      </p>
      <ul class="mt-5 flex gap-1">
        {SOCIALS.map(social => (
          <li>
            <a href={social.href} rel="noopener" target="_blank" class="grid size-11 place-items-center rounded-md text-white/85 hover:bg-white/10 hover:text-white">
              <Icon name={social.icon} size={22} label={social.title} />
            </a>
          </li>
        ))}
      </ul>
    </div>

    <nav aria-labelledby="footer-layanan">
      <h2 id="footer-layanan" class="text-lg font-bold">Layanan</h2>
      <ul class="mt-2 flex flex-col">
        {services.map(link => <li><a href={link.href} class="inline-block py-1.5 text-white/85 hover:text-white hover:underline">{link.title}</a></li>)}
      </ul>
    </nav>

    <nav aria-labelledby="footer-informasi">
      <h2 id="footer-informasi" class="text-lg font-bold">Informasi</h2>
      <ul class="mt-2 flex flex-col">
        {info.map(link => <li><a href={link.href} class="inline-block py-1.5 text-white/85 hover:text-white hover:underline">{link.title}</a></li>)}
      </ul>
    </nav>
  </div>

  <div class="border-t border-white/15">
    <p class="wrap py-5 text-sm text-white/75">© {year} {SITE_LEGAL_NAME}</p>
  </div>
</footer>
