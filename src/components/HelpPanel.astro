---
import { PHONE_CC } from '../lib/site'
import Icon from './Icon.astro'
---

<aside class="mt-16 flex flex-col gap-4 rounded-2xl bg-air p-6 sm:flex-row sm:items-center sm:justify-between sm:p-8" aria-labelledby="bantuan-judul">
  <div>
    <h2 id="bantuan-judul" class="text-lg font-bold">Perlu bantuan langsung?</h2>
    <p class="text-redup">Hubungi Contact Center lewat telepon atau datang ke unit pelayanan terdekat.</p>
  </div>
  <div class="flex shrink-0 flex-wrap gap-2">
    <a class="btn btn-primary" href={PHONE_CC.href}>
      <Icon name="mdi:phone-outline" size={20} /> Telepon {PHONE_CC.text}
    </a>
    <a class="btn btn-quiet" href="/perusahaan/kontak#unit-pelayanan">
      <Icon name="mdi:map-marker-outline" size={20} /> Cari unit pelayanan
    </a>
  </div>
</aside>
