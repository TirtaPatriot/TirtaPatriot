---
/**
 * Karosel teratas beranda: pengumuman & berita yang sama dengan yang tayang di aplikasi Tirta Patriot Mobile.
 * Isi saat build dari koleksi `pengumuman`; src/scripts/karosel.ts menggerakkan dan memperbaruinya dari API.
 * Poster dari aplikasi berukuran 16:9 dan sudah memuat teksnya sendiri, jadi selalu tampil utuh: selebar layar bila muat,
 * dan bila layar terlalu pendek, lebarnya dibatasi agar tingginya pas di bawah header (sisi kiri-kanan berwarna latar);
 * gelombang menuju hero berada di bawah poster agar tidak menutupi teksnya.
 */
import { getCollection, render } from 'astro:content'
import Icon from './Icon.astro'
import Waves from './Waves.astro'

const slides = await Promise.all((await getCollection('pengumuman'))
  .toSorted((a, b) => a.data.urutan - b.data.urutan)
  .map(async entry => ({ id: entry.id, ...entry.data, Content: (await render(entry)).Content })))

// tombol panah di tengah poster (bukan tengah section, yang termasuk ruang titik & gelombang di bawah)
const arrow = 'absolute top-[calc(50%-(clamp(36px,6vw,84px)+2.75rem)/2)] z-10 grid size-9 -translate-y-1/2 cursor-pointer place-items-center rounded-full bg-pipa-deep/75 text-white ring-1 ring-white/25 backdrop-blur transition hover:bg-patriot sm:size-14'
---

<section class="relative isolate overflow-hidden bg-pipa-deep" aria-labelledby="karosel-judul" data-karosel data-karosel-ids={slides.map(slide => slide.id).join(',')} hidden={slides.length === 0}>
  <h2 id="karosel-judul" class="sr-only">Info terkini dari aplikasi Tirta Patriot Mobile</h2>

  <ul
    class="relative flex snap-x snap-mandatory overflow-x-auto overscroll-x-contain [scrollbar-width:none] [&::-webkit-scrollbar]:hidden"
    aria-roledescription="karosel"
    aria-label="Info terkini"
    data-karosel-track
  >
    {slides.map((slide, index) => (
      <li class="w-full shrink-0 snap-start pb-[calc(clamp(36px,6vw,84px)+2.75rem)]" aria-roledescription="slide" aria-label={`${index + 1} dari ${slides.length}`} data-karosel-slide={slide.id}>
        <button type="button" class="mx-auto block w-full max-w-[calc((100svh-4.25rem-clamp(36px,6vw,84px)-2.75rem)*16/9)] cursor-pointer" aria-label={`${slide.title}, ${slide.tanggal}`} data-karosel-open data-title={slide.title} data-tanggal={slide.tanggal} data-image={slide.image ?? ''} data-gangguan={slide.gangguan ? '' : undefined}>
          {slide.image
            ? <img src={slide.image} alt="" width="1280" height="720" loading={index === 0 ? 'eager' : 'lazy'} fetchpriority={index === 0 ? 'high' : undefined} decoding="async" class="block aspect-video w-full object-cover" />
            : <span class="grid aspect-video w-full place-items-center p-8 text-center text-title font-extrabold text-white">{slide.title}</span>}
        </button>
        <template data-karosel-detail><div class="content"><slide.Content /></div></template>
      </li>
    ))}
  </ul>

  <div data-karosel-controls hidden>
    <button type="button" class:list={[arrow, 'left-1 sm:left-8']} data-karosel-prev aria-label="Sebelumnya">
      <Icon name="mdi:chevron-left" size={28} />
    </button>
    <button type="button" class:list={[arrow, 'right-1 sm:right-8']} data-karosel-next aria-label="Berikutnya">
      <Icon name="mdi:chevron-right" size={28} />
    </button>
    <div class="absolute inset-x-0 bottom-[calc(clamp(36px,6vw,84px)+0.25rem)] z-10 flex items-center justify-center gap-3">
      <div class="flex items-center gap-2 rounded-full bg-pipa-deep/55 px-3 py-2 backdrop-blur" data-karosel-dots></div>
      <button type="button" class="group grid size-8 cursor-pointer place-items-center rounded-full bg-pipa-deep/55 text-white backdrop-blur hover:bg-pipa-deep" data-karosel-play aria-label="Hentikan putar otomatis">
        <Icon name="mdi:pause" size={18} class="group-data-paused:hidden" />
        <Icon name="mdi:play" size={18} class="hidden group-data-paused:block" />
      </button>
    </div>
  </div>

  <div class="pointer-events-none">
    <Waves fill="var(--color-pipa)" />
  </div>

  <dialog class="m-auto max-h-[92vh] w-[min(94vw,46rem)] overflow-y-auto rounded-2xl bg-white p-0 text-pipa backdrop:bg-pipa/85" aria-labelledby="karosel-dialog-judul" data-karosel-dialog>
    <form method="dialog" class="sticky top-0 z-10 flex justify-end p-3 pb-0">
      <button class="grid size-10 cursor-pointer place-items-center rounded-full bg-white text-pipa shadow" aria-label="Tutup">
        <Icon name="mdi:close" size={22} />
      </button>
    </form>
    <div class="-mt-13">
      <img class="aspect-video w-full object-cover" alt="" data-karosel-dialog-image>
      <div class="p-5 sm:p-7">
        <p class="flex items-center gap-2 text-sm font-bold text-meter" data-karosel-dialog-gangguan><span class="inline-block size-2 rounded-full bg-current" aria-hidden="true" />Gangguan layanan</p>
        <h3 id="karosel-dialog-judul" class="mt-1 text-xl font-bold" data-karosel-dialog-title></h3>
        <p class="mt-1 text-sm text-redup" data-karosel-dialog-tanggal></p>
        <div class="mt-4" data-karosel-dialog-body></div>
        <a href="/informasi/gangguan-layanan" class="group link mt-6 inline-flex items-center gap-1" data-karosel-dialog-link>Semua informasi gangguan <Icon name="mdi:arrow-right" size={18} class="nudge" /></a>
      </div>
    </div>
  </dialog>
</section>
