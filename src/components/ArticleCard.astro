---
import type { CollectionEntry } from 'astro:content'
import { coverTransition } from '../lib/artikel'
import { dateLong } from '../lib/format'
import CmsImage from './CmsImage.astro'

type Props = {
  article: CollectionEntry<'artikel'>
  /** tampilan besar untuk artikel utama */
  lead?: boolean
  headingLevel?: 'h2' | 'h3'
}

const { article, lead = false, headingLevel: Heading = 'h3' } = Astro.props
const { judul, ringkasan, cover, terbit } = article.data
---

<article class:list={['group relative', lead ? 'grid gap-6 md:grid-cols-[1.35fr_1fr] md:items-center md:gap-10' : 'flex flex-col gap-4']}>
  <div class:list={['zoom-media bg-air outline-1 -outline-offset-1 outline-pipa/10', lead ? 'rounded-2xl' : 'rounded-xl']} style={`view-transition-name: ${coverTransition(article.id)}`}>
    <CmsImage
      src={cover}
      alt=""
      ratio={lead ? 16 / 10 : 3 / 2}
      widths={lead ? [640, 960, 1280] : [400, 640, 800]}
      sizes={lead ? '(min-width: 768px) 56vw, 100vw' : '(min-width: 768px) 33vw, 100vw'}
      class="w-full"
      eager={lead}
    />
  </div>
  <div>
    <time datetime={terbit.toISOString()} class="text-sm font-medium text-redup">{dateLong(terbit)}</time>
    <Heading class:list={['mt-1.5 font-bold transition-colors duration-300 group-hover:text-patriot', lead ? 'text-title' : 'clamp-3 text-lg leading-snug']}>
      <a href={`/${article.id}`} class="after:absolute after:inset-0">{judul}</a>
    </Heading>
    {ringkasan && <p class:list={['mt-2 text-redup', lead ? 'clamp-3 text-lg' : 'clamp-2']}>{ringkasan}</p>}
  </div>
</article>
