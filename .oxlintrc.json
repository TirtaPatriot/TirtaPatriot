{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "typescript",
    "unicorn",
    "oxc",
    "import"
  ],
  "categories": {
    "correctness": "error",
    "suspicious": "warn"
  },
  "ignorePatterns": [
    "dist",
    ".astro",
    "node_modules"
  ],
  "rules": {
    "import/no-unassigned-import": "off",
    "no-underscore-dangle": "off"
  }
}
